# Настройки одного корпуса. ОБРАЗЕЦ — скопировать и назвать по корпусу,
# например «do.yaml» или «instrukcii.yaml».
#
# Один конфиг — один корпус. Корпус это папка документов одного жанра и одной
# системы: инструкции отдельно, журналы изменений отдельно. Смешивать нельзя не
# из аккуратности — жанр уезжает в метаданные каждого фрагмента и по нему потом
# фильтрует поиск.
#
# Путей в коде нет вовсе: всё, что ниже, конвейер читает отсюда. Относительные
# пути считаются от папки этого файла.

# --- что это за документы -----------------------------------------------------

# Короткий код системы. Уезжает в метаданные, по нему поиск отличает одну
# систему от другой. Латиницей, без пробелов.
system: DO

# Жанр. Тоже уезжает в метаданные и тоже служит фильтром поиска.
# У нас было три: Инструкция, Концепция, Обновление.
document_type: Инструкция

# --- где лежат документы и куда положить результат -----------------------------

# Папка с исходными .docx. Читается, но не меняется.
source_dir: C:/путь/к/папке/с/документами

# Рабочая папка: сюда ложатся разборы экранов, картинки, реестр, номера.
# Создаётся сама. Переносить её вместе с инструментом НЕ надо — см. ЧИТАТЬ
# ПЕРВЫМ, там сказано почему.
work_dir: ..\work\DO
ocr_dir: ..\work\DO/ocr_deepseek
registry: ..\work\DO\meta/registry.csv
docids: ..\work\DO\meta/docids.csv
abbreviations: ..\work\DO\meta/abbreviations.txt
screen_format: ..\work\DO\meta/screen-format.md
pii_names: ..\work\DO\meta/pii-names.txt
topics:

# Готовый файл фрагментов — то, что грузится в векторную базу.
out: C:/путь/куда/положить/chunks_do.jsonl

# Сокращения, которых нет в словаре, — список на расшифровку человеку.
terms_out: C:/путь/куда/положить/Сокращения — на расшифровку.csv

# Ссылка на папку документов ДЛЯ ЧЕЛОВЕКА. Уезжает в метаданные полем
# source_url и показывается строкой «Источник».
#
# ЭТО НЕ ПУТЬ ЧТЕНИЯ. Документы берутся из source_dir, с диска. Путать эти два
# поля — отдельная ошибка: ссылка может вести куда угодно, а чтение всё равно
# идёт из папки выше.
url: https://ссылка/на/папку/для/человека

# --- номера документов ---------------------------------------------------------

# С какого номера начинать нумерацию этого корпуса и сколько документов ждать.
# Ожидание — не формальность: не сошлось, конвейер скажет об этом в отчёте.
start_doc: 1
expect_from: 1
expect_to: 30

# Потолок фрагментов на документ. Срабатывает как тревога, а не как обрезка.
max_chunks_per_doc: 60

# --- нарезка -------------------------------------------------------------------

# Границы в знаках. Режется по СТРУКТУРЕ документа, а не по числу знаков:
# target — ориентир, hard_max — предел, который не переступается.
#
# Не разрываются никогда: экран, таблица вместе с подписью, абзац с двоеточием
# вместе со списком под ним, нумерованные шаги.
chunk:
  target: 1200
  hard_max: 2500
  min: 80

# --- деньги --------------------------------------------------------------------

# ДЕНЕЖНЫЙ ПОТОЛОК НА ПРОГОН, в токенах распознавания.
#
# 300 000 — число из замеров, а не круглое. Самый дорогой прогон в нашей
# истории: 73 экрана, 261 703 токена на входе и 55 042 на выходе, итого
# 316 745. Этот потолок его бы остановил.
#
# Один экран стоит от 1000 до 4500 токенов, на плотной форме 1С около 4300.
# 300 000 — это примерно семьдесят экранов: один большой документ или три
# обычных. Партия крупнее означает, что в папку положили что-то не то.
#
# Потолок стоит НА ПРОГОН. Упёрлись — остановились, посмотрели, запустили
# снова: разобранные экраны кешированы и повторно не оплачиваются, поэтому
# остановка ничего не выбрасывает.
predel_tokenov_na_progon: 300000

# --- распознавание экранов ------------------------------------------------------

recognizer:
  provider: deepseek
  url: https://api.deepseek.com/chat/completions
  model: deepseek-v4-flash-vision-exp
  detail: high
  max_tokens: 8000
  workers: 6
  attempts: 3
  timeout: 180
  # Имя переменной окружения с ключом. Если её нет — читается файл ниже.
  api_key_env: DEEPSEEK_API_KEY
  # Файл с ключом лежит рядом с конфигом. В git не попадает: рядом только
  # образец с пустым значением.
  api_key_file: ./ключи.env
